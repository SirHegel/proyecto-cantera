# Copia este archivo a .env.local o ejecuta npm run setup.
# LOCAL: cuentas en este equipo, SQLite y proveedores ficticios para empezar.
# Puedes configurar proveedores reales por usuario desde la aplicación.
# SUPABASE: usuarios y datos compartidos; requiere las tres variables de Supabase.
CANTERA_MODE=local
PROVIDER_MODE=fixture

# Carpeta privada. Por defecto: .data/ dentro del proyecto.
# CANTERA_DATA_DIR=.data

# Solo CANTERA_MODE=supabase
# NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Proveedores en modo Supabase: fixture, cassette o live.
# cassette usa llamadas reales la primera vez y escribe en .cassettes/.
# Los modos por proveedor prevalecen sobre PROVIDER_MODE.
# PLACES_MODE=fixture
# AI_MODE=fixture
# GOOGLE_PLACES_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BULK_MODEL=gpt-5.6-luna
# OPENAI_QUALITY_MODEL=gpt-5.6-terra

# Extracción y límites de trabajo
MAX_WEBSITE_CHARS=3500
MAX_AI_ANALYSES_PER_SEARCH=25
FETCH_TIMEOUT_MS=5000
FETCH_CONCURRENCY=8

# Opcional: origen de las webs de demostración; se prefiere el de la petición.
# DEMO_SITE_BASE=http://127.0.0.1:3000

# Requerido para habilitar la purga programada en producción.
# CRON_SECRET=
